{
  "name": "contextbridge-server",
  "version": "1.0.0",
  "type": "module",
  "description": "ContextBridge local server, distillation engine, and Model Context Protocol (MCP) provider",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/static', {recursive:true}); fs.copyFileSync('src/static/mock-chat.html', 'dist/static/mock-chat.html');\"",
    "start": "node dist/index.js",
    "kill:port": "powershell -Command \"Get-NetTCPConnection -LocalPort 3100 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\""
    "mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "dotenv": "^16.4.7",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
